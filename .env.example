# Live Companies House search (free key: developer.company-information.service.gov.uk). Server-only.
COMPANIES_HOUSE_API_KEY=
# Optional: free-form assistant questions on the demo case. Without it, scripted questions still work.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
# Optional: Neon Postgres for rate-limit counters. Without it, counters are in-memory (not a real safeguard).
DATABASE_URL=
SESSION_SECRET=change-me
# Number of trusted proxies that append to X-Forwarded-For (1 behind a single host proxy such as Vercel's).
TRUSTED_PROXY_HOPS=1
# Production without DATABASE_URL keeps free-form questions OFF. Set to 1 only if you accept per-instance limits.
ALLOW_MEMORY_RATE_LIMITS=
